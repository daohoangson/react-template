{
  "name": "react-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:coverage:report": "nyc report --temp-dir coverage/storybook --report-dir coverage/storybook --reporter=lcov --reporter=text-summary",
    "storybook:kill": "kill $( ps aux | grep .bin/storybook | grep -v grep | awk '{print $2}' )",
    "storybook:pipeline": "sh -c 'npm run storybook -- --ci &' && sleep 5 && npm run storybook:test -- --coverage && npm run storybook:coverage:report && npm run storybook:kill",
    "storybook:test": "test-storybook",
    "pipeline": "npm run format:check && npm run lint && npm run test:coverage && npm run storybook:pipeline"
  },
  "dependencies": {
    "i18next": "^24.2.3",
    "i18next-browser-languagedetector": "^8.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^15.7.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/browser-chromium": "^1.49.1",
    "@storybook/addon-essentials": "^8.6.19",
    "@storybook/addon-interactions": "^8.6.19",
    "@storybook/addon-links": "^8.6.19",
    "@storybook/react": "^8.6.19",
    "@storybook/react-vite": "^8.6.19",
    "@storybook/test": "^8.6.19",
    "@storybook/test-runner": "^0.21.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.16",
    "eslint-plugin-storybook": "^0.12.0",
    "eslint-plugin-testing-library": "^7.1.1",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "storybook": "^8.6.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vite-plugin-istanbul": "^6.0.2",
    "vitest": "^4.1.11"
  }
}
